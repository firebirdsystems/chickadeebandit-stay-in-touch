{
  "scenarios": [
    {
      "name": "connections and touch history are private to their owner, even from other adults",
      "members": { "owner": "adult", "other": "adult" },
      "steps": [
        {
          "action": "db",
          "as": "owner",
          "sql": "INSERT INTO app_stay_in_touch__connections (id, member_id, name, relationship, active, interval_hours, message, recipient_member_ids, recipient_emails, last_contact_at, created_at, updated_at) VALUES (?, ?, ?, ?, 1, 168, '', '[]', '[]', ?, ?, ?)",
          "params": ["c1", "{{owner}}", "Aunt Sue", "Aunt", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "INSERT INTO app_stay_in_touch__touches (id, member_id, connection_id, kind, note, touched_at) VALUES (?, ?, ?, ?, ?, ?)",
          "params": ["t1", "{{owner}}", "c1", "call", "Caught up", "2026-01-01T00:00:00Z"],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "SELECT id, name FROM app_stay_in_touch__connections",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "c1", "name": "Aunt Sue" }] }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "SELECT id FROM app_stay_in_touch__touches",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "t1" }] }
        },
        {
          "action": "db",
          "as": "other",
          "sql": "SELECT id FROM app_stay_in_touch__connections",
          "expect": { "status": 200, "rowCount": 0 }
        },
        {
          "action": "db",
          "as": "other",
          "sql": "SELECT id FROM app_stay_in_touch__touches",
          "expect": { "status": 200, "rowCount": 0 }
        }
      ]
    },
    {
      "name": "another member cannot pause, edit or delete someone else's connection",
      "members": { "owner": "adult", "other": "adult" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_stay_in_touch__connections (id, member_id, name, active, interval_hours, created_at, updated_at) VALUES ('c1', ?, 'Grandpa', 1, 168, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": ["{{owner}}"]
        },
        {
          "action": "db",
          "as": "other",
          "sql": "UPDATE app_stay_in_touch__connections SET active = 0, updated_at = ? WHERE id = ?",
          "params": ["2026-01-02T00:00:00Z", "c1"]
        },
        {
          "action": "db",
          "as": "other",
          "sql": "DELETE FROM app_stay_in_touch__connections WHERE id = ?",
          "params": ["c1"]
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "SELECT id FROM app_stay_in_touch__connections WHERE active = 1",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "c1" }] }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "UPDATE app_stay_in_touch__connections SET active = 0, updated_at = ? WHERE id = ?",
          "params": ["2026-01-02T00:00:00Z", "c1"],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "SELECT id FROM app_stay_in_touch__connections WHERE active = 1",
          "expect": { "status": 200, "rowCount": 0 }
        }
      ]
    },
    {
      "name": "a cadence must be positive",
      "members": { "owner": "adult" },
      "steps": [
        {
          "action": "db",
          "as": "owner",
          "sql": "INSERT INTO app_stay_in_touch__connections (id, member_id, name, active, interval_hours, created_at, updated_at) VALUES (?, ?, ?, 1, 0, ?, ?)",
          "params": ["c-bad", "{{owner}}", "Nobody", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"],
          "expect": { "status": 400 }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "INSERT INTO app_stay_in_touch__connections (id, member_id, name, active, interval_hours, created_at, updated_at) VALUES (?, ?, ?, 1, 24, ?, ?)",
          "params": ["c-ok", "{{owner}}", "Somebody", "2026-01-01T00:00:00Z", "2026-01-01T00:00:00Z"],
          "expect": { "status": 200 }
        },
        {
          "action": "db",
          "as": "owner",
          "sql": "SELECT id FROM app_stay_in_touch__connections",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "c-ok" }] }
        }
      ]
    },
    {
      "name": "overdue_connections returns only the caller's active, overdue connections",
      "members": { "owner": "adult", "other": "adult" },
      "steps": [
        {
          "action": "seedRaw",
          "sql": "INSERT INTO app_stay_in_touch__connections (id, member_id, name, active, interval_hours, last_contact_at, created_at, updated_at) VALUES ('c-due', ?, 'Overdue', 1, 24, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z'), ('c-never', ?, 'Never contacted', 1, 24, NULL, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z'), ('c-paused', ?, 'Paused', 0, 24, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z'), ('c-fresh', ?, 'Long cadence', 1, 10000000, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z'), ('c-theirs', ?, 'Other member', 1, 24, '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z', '2026-01-01T00:00:00Z')",
          "params": ["{{owner}}", "{{owner}}", "{{owner}}", "{{owner}}", "{{other}}"]
        },
        {
          "action": "named",
          "as": "owner",
          "kind": "query",
          "name": "overdue_connections",
          "expect": { "status": 200, "rowCount": 2, "rowsContain": [{ "id": "c-due", "name": "Overdue" }, { "id": "c-never" }] }
        },
        {
          "action": "named",
          "as": "other",
          "kind": "query",
          "name": "overdue_connections",
          "expect": { "status": 200, "rowCount": 1, "rowsContain": [{ "id": "c-theirs" }] }
        }
      ]
    }
  ]
}
